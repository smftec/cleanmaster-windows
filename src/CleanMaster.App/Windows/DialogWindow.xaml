<Window x:Class="CleanMaster.App.Windows.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" SizeToContent="Height"
        MinWidth="420" MaxWidth="560" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowActivated="True">
    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="16"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
            Margin="16" Padding="26,24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.28"/>
        </Border.Effect>
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- 严重级图标:随对话框类型变化(信息/确认/警告/危险) -->
                <Grid x:Name="IconHost" Width="46" Height="46" VerticalAlignment="Top" Margin="0,0,0,4">
                    <Ellipse x:Name="IconBg"/>
                    <Path x:Name="IconGlyph" Stretch="Uniform" Width="22" Height="22"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Grid>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="TitleText" Text="标题" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="MessageText" Text="内容" FontSize="13" LineHeight="22"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
            <StackPanel x:Name="ButtonRow" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,24,0,0"/>
        </StackPanel>
    </Border>
</Window>
