<Window x:Class="CleanMaster.App.Windows.LeftoverDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="620" SizeToContent="Height" MaxHeight="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="16"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
            Margin="16" Padding="28,24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.28"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="{DynamicResource leftover.title}" FontSize="17" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{DynamicResource leftover.desc}"
                       FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,10,0,0" TextWrapping="Wrap"/>
            <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                <StackPanel x:Name="ItemList"/>
            </ScrollViewer>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="BtnSkip" Content="{DynamicResource leftover.skip}" Style="{StaticResource SecondaryButton}"
                        MinWidth="120" Margin="0,0,12,0" Click="BtnSkip_Click"/>
                <Button x:Name="BtnClean" Content="{DynamicResource leftover.clean}" Style="{StaticResource PrimaryButton}"
                        MinWidth="120" Click="BtnClean_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
