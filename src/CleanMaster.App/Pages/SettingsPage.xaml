<Page x:Class="CleanMaster.App.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FontFamily="Microsoft YaHei UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" HorizontalAlignment="Stretch" Margin="4,2,4,20">

            <TextBlock Text="{DynamicResource settings.title}" FontSize="21" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="4,2,0,0"/>

            <!-- 通用 -->
            <Border Style="{StaticResource CardBorder}" Margin="2,16,2,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource settings.sec.general}" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <StackPanel x:Name="GeneralSection" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- 清理 -->
            <Border Style="{StaticResource CardBorder}" Margin="2,16,2,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource nav.clean}" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <StackPanel x:Name="CleanSection" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- 排除与白名单 -->
            <Border Style="{StaticResource CardBorder}" Margin="2,16,2,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource settings.sec.exclude}" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource settings.exc.desc}" FontSize="12"
                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,8,0,0"/>
                    <StackPanel x:Name="ExclusionList" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{DynamicResource settings.btn.addexclude}" Style="{StaticResource SmallSecondaryButton}"
                                Click="BtnAddExclude_Click"/>
                        <Button Content="{DynamicResource settings.btn.addwhitelist}" Style="{StaticResource SmallSecondaryButton}"
                                Margin="10,0,0,0" Click="BtnAddWhitelist_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 通知 -->
            <Border Style="{StaticResource CardBorder}" Margin="2,16,2,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource settings.sec.notify}" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <StackPanel x:Name="NotifySection" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- 高级 -->
            <Border Style="{StaticResource CardBorder}" Margin="2,16,2,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource settings.sec.advanced}" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <StackPanel x:Name="AdvancedSection" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- 隐私 -->
            <Border Style="{StaticResource CardBorder}" Margin="2,16,2,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource settings.sec.privacy}" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource settings.privacy.desc}"
                               FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,8,0,0"/>
                    <StackPanel x:Name="PrivacySection" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{DynamicResource btn.clearlocal}" Style="{StaticResource SmallSecondaryButton}"
                                Click="BtnClearLocal_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <Border Style="{StaticResource CardBorder}" Margin="2,16,2,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource settings.sec.about}" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource PrimaryGradientBrush}">
                            <Path Data="{StaticResource BroomIcon}" Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="24" Height="24" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="AboutAppName" Text="CleanMaster" FontSize="14.5" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="AboutVersion" Text="v1.0.0" FontSize="11.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,3,0,0"/>
                            <TextBlock Text="{DynamicResource settings.about.slogan}" FontSize="11.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource settings.about.support}" FontSize="12.5" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,18,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{DynamicResource settings.about.site}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center" Margin="10,0,0,0">
                            <Hyperlink NavigateUri="https://52xn.com" RequestNavigate="OpenLink" Foreground="{DynamicResource PrimaryBrush}">52xn.com</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{DynamicResource settings.about.email}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center" Margin="10,0,0,0">
                            <Hyperlink NavigateUri="mailto:dev@52xn.com" RequestNavigate="OpenLink" Foreground="{DynamicResource PrimaryBrush}">dev@52xn.com</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{DynamicResource settings.about.repo}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center" Margin="10,0,0,0">
                            <Hyperlink NavigateUri="https://github.com/smftec/cleanmaster-windows" RequestNavigate="OpenLink" Foreground="{DynamicResource PrimaryBrush}">github.com/smftec/cleanmaster-windows</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Border Background="#1FBF57" CornerRadius="10" Padding="10">
                            <Image Source="Assets/wechat-search.png" Width="300" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="{DynamicResource settings.about.wechat}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="14,4,0,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="200"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
