<Page x:Class="CleanMaster.App.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FontFamily="Microsoft YaHei UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" HorizontalAlignment="Stretch" Margin="4,2,4,20">

            <TextBlock Text="设置" FontSize="21" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="4,2,0,0"/>

            <!-- 通用 -->
            <Border Style="{StaticResource CardBorder}" Margin="2,16,2,0">
                <StackPanel>
                    <TextBlock Text="通用" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <StackPanel x:Name="GeneralSection" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- 清理 -->
            <Border Style="{StaticResource CardBorder}" Margin="2,16,2,0">
                <StackPanel>
                    <TextBlock Text="清理" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <StackPanel x:Name="CleanSection" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- 排除与白名单 -->
            <Border Style="{StaticResource CardBorder}" Margin="2,16,2,0">
                <StackPanel>
                    <TextBlock Text="排除目录与白名单" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="这些目录与文件在所有扫描和清理中都会被跳过。" FontSize="12"
                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,8,0,0"/>
                    <StackPanel x:Name="ExclusionList" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="添加排除目录" Style="{StaticResource SmallSecondaryButton}"
                                Click="BtnAddExclude_Click"/>
                        <Button Content="添加白名单文件/目录" Style="{StaticResource SmallSecondaryButton}"
                                Margin="10,0,0,0" Click="BtnAddWhitelist_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 通知 -->
            <Border Style="{StaticResource CardBorder}" Margin="2,16,2,0">
                <StackPanel>
                    <TextBlock Text="通知" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <StackPanel x:Name="NotifySection" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- 高级 -->
            <Border Style="{StaticResource CardBorder}" Margin="2,16,2,0">
                <StackPanel>
                    <TextBlock Text="高级" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <StackPanel x:Name="AdvancedSection" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- 隐私 -->
            <Border Style="{StaticResource CardBorder}" Margin="2,16,2,0">
                <StackPanel>
                    <TextBlock Text="隐私" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="扫描数据全部保存在本地。本应用不收集、不上传任何文件名、路径与内容。"
                               FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,8,0,0"/>
                    <StackPanel x:Name="PrivacySection" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="清除本地历史记录" Style="{StaticResource SmallSecondaryButton}"
                                Click="BtnClearLocal_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <Border Style="{StaticResource CardBorder}" Margin="2,16,2,0">
                <StackPanel>
                    <TextBlock Text="关于" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="清理优化大师 v1.0.0" FontSize="13" Margin="0,10,0,0"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="清得明白，优化得安心。可解释、可预览、可恢复的 Windows 清理与优化工具。"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                    <TextBlock Text="安全承诺：默认只勾选 L0/L1 安全项目；关键删除进隔离区；不提供伪优化（内存加速球/注册表魔改等）。"
                               FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
