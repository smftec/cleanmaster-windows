<Page x:Class="CleanMaster.App.Pages.SmartScanPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FontFamily="Microsoft YaHei UI">
    <Grid>
        <!-- ============ 待机 ============ -->
        <ScrollViewer x:Name="PanelIdle" Visibility="Visible"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="760" HorizontalAlignment="Center" Margin="0,40,0,20">
                <Button x:Name="BigScanBtn" Click="BtnStartScan_Click" Cursor="Hand" Background="Transparent"
                        BorderThickness="0" Padding="0" HorizontalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Width="210" Height="210">
                                <Ellipse Fill="{DynamicResource PrimarySoftBrush}" Opacity="0.55" Margin="12"/>
                                <Ellipse x:Name="inner" Fill="{DynamicResource PrimaryGradientBrush}" Margin="30">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="26" ShadowDepth="5" Direction="270"
                                                          Opacity="0.35" Color="#2774F0"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <StackPanel VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Path Data="{StaticResource BroomIcon}" Stroke="White" StrokeThickness="2.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="52" Height="52" Stretch="Uniform" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource scan.start}" FontSize="17" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="inner" Property="Opacity" Value="0.93"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="inner" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock Text="{DynamicResource scan.cover}"
                           FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,30,0,0"/>
                <TextBlock Text="{DynamicResource scan.privacy}"
                           FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ 扫描中 ============ -->
        <StackPanel x:Name="PanelScanning" Visibility="Collapsed" MaxWidth="720"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Width="140" Height="140" HorizontalAlignment="Center">
                <Ellipse Stroke="{DynamicResource PrimarySoftBrush}" StrokeThickness="10"/>
                <Ellipse x:Name="ScanSpin" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="10"
                         StrokeDashArray="0.28 0.72" StrokeDashCap="Round" StrokeStartLineCap="Round">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="SpinTransform" CenterX="70" CenterY="70"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ScanPercentText" Text="0%" FontSize="25" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ScanFoundText" Text="{DynamicResource scan.found}" FontSize="11.5"
                               Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="ScanStageText" Text="{DynamicResource scan.preparing}" FontSize="15" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,26,0,0"/>
            <TextBlock x:Name="ScanDetailText" Text="" FontSize="11.5" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            <ProgressBar x:Name="ScanProgressBar" Maximum="100" Value="0" Width="380" Margin="0,18,0,0"/>
            <Button x:Name="BtnStopScan" Content="{DynamicResource btn.stopscan}" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Center" Margin="0,26,0,0" Click="BtnStopScan_Click"/>
        </StackPanel>

        <!-- ============ 结果 ============ -->
        <Grid x:Name="PanelResults" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,14" Padding="20,16">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="40" Height="40">
                            <Ellipse Fill="{DynamicResource SuccessSoftBrush}"/>
                            <Path Data="{StaticResource CheckIcon}" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="18" Height="18" Stretch="Uniform"/>
                        </Grid>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ResultTitleText" Text="{DynamicResource scan.done}" FontSize="17" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="ResultSubText" Text="" FontSize="12.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="BtnRescan" Content="{DynamicResource btn.rescan}" Style="{StaticResource SmallSecondaryButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnStartScan_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ResultGroups" Margin="0,0,4,8"/>
            </ScrollViewer>

            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,14,0,0" Padding="20,13">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource common.selected}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="SelCountText" Text="0 项" FontSize="13.5" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="6,0,0,0"/>
                        <TextBlock Text="{DynamicResource common.freeable}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,0,0,0"/>
                        <TextBlock x:Name="SelSizeText" Text="0 B" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}" Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnReselectAll" Content="{DynamicResource scan.reselectall}" Style="{StaticResource SmallSecondaryButton}"
                                VerticalAlignment="Center" Margin="0,0,12,0" Click="BtnReselectAll_Click"/>
                        <Button x:Name="BtnCleanSelected" Content="{DynamicResource btn.clean.selected}" Style="{StaticResource PrimaryButton}"
                                Click="BtnCleanSelected_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ 清理中 ============ -->
        <StackPanel x:Name="PanelCleaning" Visibility="Collapsed" MaxWidth="620"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Width="120" Height="120" HorizontalAlignment="Center">
                <Ellipse Stroke="{DynamicResource PrimarySoftBrush}" StrokeThickness="9"/>
                <Ellipse Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="9"
                         StrokeDashArray="0.3 0.7" StrokeDashCap="Round" StrokeStartLineCap="Round"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="CleanSpinTransform"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Path Data="{StaticResource CleanIcon}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeLineJoin="Round" Width="40" Height="40" Stretch="Uniform"/>
            </Grid>
            <TextBlock x:Name="CleanTitleText" Text="{DynamicResource clean.title}" FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,22,0,0"/>
            <TextBlock x:Name="CleanDetailText" Text="" FontSize="11.5" TextTrimming="CharacterEllipsis" MaxWidth="480"
                       Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <ProgressBar x:Name="CleanProgressBar" Maximum="100" Value="0" Width="380" Margin="0,16,0,0"/>
            <TextBlock x:Name="CleanFreedText" Text="{DynamicResource clean.freed}" FontSize="13" FontWeight="Bold"
                       Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
            <Button x:Name="BtnStopClean" Content="{DynamicResource btn.cancel}" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Center" Margin="0,22,0,0" Click="BtnStopClean_Click"/>
        </StackPanel>

        <!-- ============ 完成 ============ -->
        <ScrollViewer x:Name="PanelDone" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="640" HorizontalAlignment="Center" Margin="0,36,0,20">
                <Grid Width="88" Height="88" HorizontalAlignment="Center">
                    <Ellipse Fill="{DynamicResource SuccessSoftBrush}"/>
                    <Path Data="{StaticResource CheckIcon}" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="38" Height="38" Stretch="Uniform"/>
                </Grid>
                <TextBlock x:Name="DoneTitleText" Text="{DynamicResource done.title}" FontSize="23" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                <TextBlock x:Name="DoneFreedText" Text="" FontSize="15" Foreground="{DynamicResource SuccessBrush}"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>

                <Border Style="{StaticResource CardBorder}" Margin="0,26,0,0" Padding="24,18">
                    <UniformGrid Columns="4">
                        <StackPanel>
                            <TextBlock x:Name="DoneOkText" Text="0" FontSize="21" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource done.stat.ok}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="DoneQuarText" Text="0" FontSize="21" FontWeight="Bold"
                                       Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource done.stat.quar}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="DoneSkipText" Text="0" FontSize="21" FontWeight="Bold"
                                       Foreground="{DynamicResource OrangeBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource done.stat.skip}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="DoneFailText" Text="0" FontSize="21" FontWeight="Bold"
                                       Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource done.stat.fail}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </UniformGrid>
                </Border>
                <TextBlock x:Name="DoneNoteText" Text="{DynamicResource done.note.skip}"
                           FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" Margin="0,14,0,0" TextWrapping="Wrap" TextAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                    <Button Content="{DynamicResource btn.done.home}" Style="{StaticResource PrimaryButton}" MinWidth="130"
                            Margin="0,0,14,0" Click="BtnDoneHome_Click"/>
                    <Button Content="{DynamicResource btn.done.quarantine}" Style="{StaticResource SecondaryButton}" MinWidth="120"
                            Click="BtnDoneQuarantine_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
