<Page x:Class="CleanMaster.App.Pages.AppsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FontFamily="Microsoft YaHei UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,2,4,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource nav.apps}" FontSize="21" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{DynamicResource apps.desc}" FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,8,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Width="200" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged"/>
                <ComboBox x:Name="SortSelector" Width="120" Margin="12,0,0,0" SelectionChanged="Sort_Changed">
                    <ComboBoxItem Content="{DynamicResource apps.sort.name}" Tag="name" IsSelected="True"/>
                    <ComboBoxItem Content="{DynamicResource apps.sort.size}" Tag="size"/>
                    <ComboBoxItem Content="{DynamicResource apps.sort.date}" Tag="date"/>
                </ComboBox>
                <Button x:Name="BtnRefresh" Content="{DynamicResource btn.refresh}" Style="{StaticResource SecondaryButton}"
                        Padding="18,8" Margin="12,0,0,0" Click="BtnRefresh_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="2,14,2,0">
            <Border Style="{StaticResource CardBorder}" Padding="10,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="14,6,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.6*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource apps.col.name}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource apps.col.publisher}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock Grid.Column="2" Text="{DynamicResource apps.col.size}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock Grid.Column="3" Text="{DynamicResource apps.col.date}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="AppList"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="240" Height="6"/>
                <TextBlock x:Name="LoadingText" Text="{DynamicResource apps.loading}" FontSize="12.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,14,0,0"/>
            </StackPanel>
            <TextBlock x:Name="EmptyText" Text="{DynamicResource apps.empty}" FontSize="12.5"
                       Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"
                       Visibility="Collapsed" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>
