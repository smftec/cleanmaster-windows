<Page x:Class="CleanMaster.App.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FontFamily="Microsoft YaHei UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch">

            <!-- ======== 顶部状态区 ======== -->
            <Grid Margin="6,4,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="46" Height="46" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusEllipse" Fill="{DynamicResource SuccessSoftBrush}"/>
                            <Path x:Name="StatusIcon" Data="{StaticResource CheckIcon}"
                                  Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="20" Height="20" Stretch="Uniform"/>
                        </Grid>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusTitle" Text="{DynamicResource home.status.good}" FontSize="27" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <TextBlock x:Name="LastScanText" Text="{DynamicResource home.noscan}" FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource home.slogan}" FontSize="12.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,7,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="62,22,0,6">
                        <Button x:Name="BtnScan" Style="{StaticResource PrimaryButton}" Click="BtnScan_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource btn.scan.now}" VerticalAlignment="Center"/>
                                <Path Data="{StaticResource ChevronRightIcon}" Stroke="White" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="9" Height="9" Stretch="None" Margin="10,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnMore" Style="{StaticResource SecondaryButton}" Margin="16,0,0,0"
                                Click="BtnMore_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource DotsIcon}" Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="2.4" StrokeStartLineCap="Round" Width="14" Height="14" Stretch="None"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource btn.more}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- 右侧健康评分 -->
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="0" Margin="10,4,10,0"
                        VerticalAlignment="Center" Click="Health_Click" Cursor="Hand"
                        ToolTip="{DynamicResource home.health.tip}">
                    <StackPanel Orientation="Horizontal" Margin="18,14,20,14">
                        <StackPanel x:Name="HealthRingHost" VerticalAlignment="Center"/>
                        <StackPanel Margin="18,0,4,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource home.health.title}" FontSize="12.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="HealthLevelText" Text="—" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,5,0,0"/>
                            <StackPanel x:Name="HealthChips" Margin="0,10,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ======== 四张状态卡片 ======== -->
            <UniformGrid Columns="4" Margin="2,18,2,0">
                <Button Style="{StaticResource SecondaryButton}" Padding="0" Margin="0,0,12,0" Click="CardJunk_Click">
                    <Grid HorizontalAlignment="Stretch" Margin="0">
                        <StackPanel HorizontalAlignment="Left" Margin="18,16,8,16">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource PrimarySoftBrush}">
                                    <Path Data="{StaticResource CleanIcon}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeLineJoin="Round" Width="19" Height="19" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="{DynamicResource home.card.junk}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <Path Data="{StaticResource ChevronRightIcon}" Stroke="{DynamicResource TextTertiaryBrush}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="8" Height="8" Stretch="None" VerticalAlignment="Center" Margin="8,1,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="JunkSizeText" Text="—" FontSize="26" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                            <TextBlock x:Name="JunkNoteText" Text="{DynamicResource home.card.junk.note}" FontSize="11.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Padding="0" Margin="0,0,12,0" Click="CardStartup_Click">
                    <StackPanel HorizontalAlignment="Left" Margin="18,16,8,16">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource WarningSoftBrush}">
                                <Path Data="{StaticResource PowerIcon}" Stroke="{DynamicResource OrangeBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeLineJoin="Round" Width="19" Height="19" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="{DynamicResource home.card.startup}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <Path Data="{StaticResource ChevronRightIcon}" Stroke="{DynamicResource TextTertiaryBrush}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="8" Height="8" Stretch="None" VerticalAlignment="Center" Margin="8,1,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="StartupCountText" Text="—" FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                        <TextBlock x:Name="StartupNoteText" Text="{DynamicResource home.card.startup.note}" FontSize="11.5"
                                   Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Padding="0" Margin="0,0,12,0" Click="CardLarge_Click">
                    <StackPanel HorizontalAlignment="Left" Margin="18,16,8,16">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource SuccessSoftBrush}">
                                <Path Data="{StaticResource FileIcon}" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeLineJoin="Round" Width="19" Height="19" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="{DynamicResource home.card.large}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <Path Data="{StaticResource ChevronRightIcon}" Stroke="{DynamicResource TextTertiaryBrush}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="8" Height="8" Stretch="None" VerticalAlignment="Center" Margin="8,1,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="LargeCountText" Text="—" FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                        <TextBlock x:Name="LargeNoteText" Text="{DynamicResource home.card.large.note}" FontSize="11.5"
                                   Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Padding="0" Click="CardApps_Click">
                    <StackPanel HorizontalAlignment="Left" Margin="18,16,8,16">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource PrimarySoftBrush}">
                                <Path Data="{StaticResource BoxIcon}" Stroke="{DynamicResource PurpleBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeLineJoin="Round" Width="19" Height="19" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="{DynamicResource home.card.apps}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <Path Data="{StaticResource ChevronRightIcon}" Stroke="{DynamicResource TextTertiaryBrush}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="8" Height="8" Stretch="None" VerticalAlignment="Center" Margin="8,1,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="AppsCountText" Text="—" FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                        <TextBlock x:Name="AppsNoteText" Text="{DynamicResource home.card.apps.note}" FontSize="11.5"
                                   Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- ======== 实时系统状态 ======== -->
            <Border Style="{StaticResource CardBorder}" Margin="2,14,2,0" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource home.mon.title}" FontSize="14.5" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="{DynamicResource SuccessBrush}"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource home.mon.live}" FontSize="11"
                                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel x:Name="CpuHost" Orientation="Horizontal" Margin="0,0,26,0"/>
                        <StackPanel x:Name="RamHost" Orientation="Horizontal" Margin="0,0,26,0"/>
                        <StackPanel x:Name="UptimeHost" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======== 磁盘 + 空间分析 ======== -->
            <Grid Margin="2,14,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="11*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="9*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" x:Name="DiskRingHost" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="34" Height="34" CornerRadius="10"
                                            Background="{DynamicResource PrimarySoftBrush}">
                                        <Path Data="{StaticResource BoxIcon}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.7"
                                              StrokeStartLineCap="Round" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock x:Name="DiskTitle" Text="{DynamicResource home.disk.title}" FontSize="15" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="DiskTotalText" Text="{DynamicResource home.disk.total}" FontSize="12.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Ellipse Width="9" Height="9" Fill="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DiskUsedText" Text="{DynamicResource home.disk.used}" FontSize="12.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                                <Ellipse Width="9" Height="9" Fill="{DynamicResource TrackBrush}" VerticalAlignment="Center" Margin="22,0,0,0"/>
                                <TextBlock x:Name="DiskFreeText" Text="{DynamicResource home.disk.free}" FontSize="12.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnAnalyze" Content="{DynamicResource home.disk.more}" Style="{StaticResource LinkButton}"
                                    HorizontalAlignment="Left" Margin="0,16,0,0" Click="BtnAnalyze_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <Grid>
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{DynamicResource home.space.title}" FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                                        Click="BtnAnalyze2_Click" VerticalAlignment="Center">
                                    <Path Data="{StaticResource ChevronRightIcon}" Stroke="{DynamicResource TextTertiaryBrush}"
                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="9" Height="9" Stretch="None"/>
                                </Button>
                            </Grid>
                            <UniformGrid Columns="3" Rows="2" Margin="0,14,0,0">
                                <Border x:Name="Cat0" CornerRadius="9" Margin="1,3,3,3" Background="{DynamicResource PrimaryBrush}" MinHeight="74" Opacity="0.25">
                                    <StackPanel VerticalAlignment="Center" Margin="12,8"/>
                                </Border>
                                <Border x:Name="Cat1" CornerRadius="9" Margin="3,3,1,3" Background="{DynamicResource TealBrush}" MinHeight="74" Opacity="0.25">
                                    <StackPanel VerticalAlignment="Center" Margin="12,8"/>
                                </Border>
                                <Border x:Name="Cat2" CornerRadius="9" Margin="3,3,3,3" Background="{DynamicResource PurpleBrush}" MinHeight="74" Opacity="0.25">
                                    <StackPanel VerticalAlignment="Center" Margin="12,8"/>
                                </Border>
                                <Border x:Name="Cat3" CornerRadius="9" Margin="1,3,3,3" Background="{DynamicResource OrangeBrush}" MinHeight="74" Opacity="0.25">
                                    <StackPanel VerticalAlignment="Center" Margin="12,8"/>
                                </Border>
                                <Border x:Name="Cat4" CornerRadius="9" Margin="3,3,1,3" Background="{DynamicResource PinkBrush}" MinHeight="74" Opacity="0.25">
                                    <StackPanel VerticalAlignment="Center" Margin="12,8"/>
                                </Border>
                                <Border x:Name="Cat5" CornerRadius="9" Margin="3,3,3,3" Background="{DynamicResource TextTertiaryBrush}" MinHeight="74" Opacity="0.25">
                                    <StackPanel VerticalAlignment="Center" Margin="12,8"/>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                        <Border x:Name="AnalysisEmpty" Background="{DynamicResource CardBgBrush}" CornerRadius="10"
                                Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{DynamicResource home.space.empty}" FontSize="12.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <Button x:Name="BtnQuickAnalyze" Content="{DynamicResource btn.analyze.start}" Style="{StaticResource SmallPrimaryButton}"
                                        Margin="0,10,0,0" HorizontalAlignment="Center" Click="BtnAnalyze_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ======== 最近活动 + 智能建议 ======== -->
            <Grid Margin="2,16,2,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{DynamicResource home.activity.title}" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Click="BtnHistory_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource common.viewall}"/>
                                    <Path Data="{StaticResource ChevronRightIcon}" Stroke="{DynamicResource TextTertiaryBrush}"
                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="8" Height="8" Stretch="None" Margin="4,1,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ItemsControl x:Name="ActivityList" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,7">
                                        <Border Width="34" Height="34" CornerRadius="10"
                                                Background="{DynamicResource PrimarySoftBrush}" VerticalAlignment="Center">
                                            <Path x:Name="ActIcon" Data="{StaticResource BroomIcon}"
                                                  Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                                  Width="17" Height="17" Stretch="Uniform"/>
                                        </Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding TimeText}" FontSize="11.5"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Path Data="{StaticResource CheckIcon}" Stroke="{DynamicResource SuccessBrush}"
                                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"
                                              HorizontalAlignment="Right" Margin="12,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel x:Name="NoActivityPanel" Margin="0,14,0,6" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource home.activity.empty}" FontSize="12.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                            <Button Content="{DynamicResource btn.scan.now}" Style="{StaticResource SmallSecondaryButton}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0" Click="BtnScan_Click"/>
                        </StackPanel>
                        <Border Background="{DynamicResource ItemHoverBrush}" CornerRadius="10"
                                Padding="12,10" Margin="0,12,0,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{DynamicResource home.stats.days7}" FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StatsTotalText" Text="" FontSize="11.5"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel x:Name="StatsBars" Orientation="Horizontal" Height="52" Margin="0,10,0,2"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{DynamicResource home.suggest.title}" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsControl x:Name="SuggestList" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ItemHoverBrush}" CornerRadius="11"
                                            Padding="13,11" Margin="0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource PrimarySoftBrush}"
                                                    VerticalAlignment="Center">
                                                <Path Data="{StaticResource CleanIcon}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.7"
                                                      StrokeStartLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Note}" FontSize="11.5"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12.5" FontWeight="Bold"
                                                       Foreground="{DynamicResource OrangeBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <Button Grid.Column="3" Content="{Binding ActionText}"
                                                    Style="{StaticResource SmallPrimaryButton}"
                                                    Tag="{Binding}" Click="SuggestAction_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoSuggestText" Text="{DynamicResource home.suggest.empty}" FontSize="12.5"
                                   Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,14,0,6"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
