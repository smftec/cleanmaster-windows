<Page x:Class="CleanMaster.App.Pages.SpaceAnalysisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FontFamily="Microsoft YaHei UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <Grid Grid.Row="0" Margin="4,2,4,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource nav.space}" FontSize="21" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <ComboBox x:Name="DriveSelector" Width="150" Margin="20,0,0,0"
                          SelectionChanged="DriveSelector_Changed"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <RadioButton x:Name="TabOverview" Content="{DynamicResource space.tab.overview}" Style="{StaticResource PillTab}"
                             GroupName="satabs" IsChecked="True" Checked="OverviewTab_Checked"/>
                <RadioButton x:Name="TabLarge" Content="{DynamicResource space.tab.large}" Style="{StaticResource PillTab}"
                             GroupName="satabs" Checked="LargeTab_Checked"/>
                <Button x:Name="BtnAnalyze" Content="{DynamicResource btn.analyze.start}" Style="{StaticResource PrimaryButton}"
                        Padding="20,8" Margin="14,0,0,0" Click="BtnAnalyze_Click"/>
            </StackPanel>
        </Grid>

        <!-- 概览条 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="2,14,2,0" Padding="20,16"
                x:Name="OverviewCard">
            <Grid>
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="OverviewDriveText" Text="C:" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="OverviewUsedText" Text="" FontSize="12.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                       Margin="14,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="OverviewTimeText" Text="" FontSize="11.5"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <ProgressBar x:Name="DiskUsageBar" Height="14" Margin="0,14,0,0" Maximum="100"
                                 Foreground="{DynamicResource PrimaryBrush}"/>
                    <StackPanel x:Name="CategoryRow" Orientation="Horizontal" Margin="0,14,0,0"/>
                    <TextBlock x:Name="OverviewEmptyText" Text="{DynamicResource space.empty}"
                               FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容 -->
        <Grid Grid.Row="2" Margin="2,14,2,0">
            <!-- 分析进度覆盖 -->
            <Border x:Name="AnalyzePanel" Style="{StaticResource CardBorder}" Padding="30,24"
                    Visibility="Collapsed" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{DynamicResource space.scanning}" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="AnalyzeDirText" Text="" FontSize="11" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,10,0,0"/>
                    <ProgressBar x:Name="AnalyzeBar" IsIndeterminate="True" Height="6" Margin="0,14,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock x:Name="AnalyzeFilesText" Text="已扫描 0 个文件" FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AnalyzeBytesText" Text="共 0 B" FontSize="12.5" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}" Margin="18,0,0,0" VerticalAlignment="Center"/>
                        <Button x:Name="BtnCancelAnalyze" Content="{DynamicResource btn.cancel}" Style="{StaticResource SmallSecondaryButton}"
                                Margin="20,0,0,0" Click="BtnCancelAnalyze_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 概览：目录树 -->
            <Border x:Name="TreeCard" Style="{StaticResource CardBorder}" Padding="10,10" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="14,6,14,8">
                        <TextBlock Text="{DynamicResource space.tree.title}" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource space.tree.hint}" FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TreeView Grid.Row="1" x:Name="FolderTree" Background="Transparent"
                              BorderThickness="0" ItemContainerStyle="{StaticResource FolderTreeItem}">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Grid Margin="0,3" MinWidth="640">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="12.5"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                                    <ProgressBar Grid.Column="1" Value="{Binding Percent}" Maximum="100"
                                                 Height="6" Margin="10,0,14,0" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource PrimaryBrush}" Opacity="0.8"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="{Binding CountText}" FontSize="10.5"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- 大文件 -->
            <Border x:Name="LargeCard" Style="{StaticResource CardBorder}" Padding="16,14" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="6,2,6,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource space.tab.large}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="LargeSummaryText" Text="" FontSize="11.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="12,0,0,0"/>
                            <TextBlock Text="{DynamicResource space.large.filter}" FontSize="12" VerticalAlignment="Center" Margin="24,0,8,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox x:Name="LargeThreshold" Width="120" SelectionChanged="LargeThreshold_Changed">
                                <ComboBoxItem Content="> 500 MB" Tag="500" IsSelected="True"/>
                                <ComboBoxItem Content="> 1 GB" Tag="1000"/>
                                <ComboBoxItem Content="> 5 GB" Tag="5000"/>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource space.large.hint}" FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LargeList"/>
                    </ScrollViewer>
                    <TextBlock x:Name="LargeEmptyText" Text="没有找到符合条件的大文件；先点击「开始分析」扫描磁盘" FontSize="12.5"
                               Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Grid.Row="1"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
