<Page x:Class="CleanMaster.App.Pages.StartupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FontFamily="Microsoft YaHei UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,2,4,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="启动项" FontSize="21" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="关闭启动项后应用仍可手动打开；所有修改都会记录原状态，可随时恢复。" FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,8,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Width="220" VerticalAlignment="Center"
                         TextChanged="SearchBox_TextChanged"/>
                <Button x:Name="BtnRefresh" Content="刷新" Style="{StaticResource SecondaryButton}"
                        Padding="18,8" Margin="12,0,0,0" Click="BtnRefresh_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="2,14,2,0">
            <Border Style="{StaticResource CardBorder}" Padding="10,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- 表头 -->
                    <Grid Grid.Row="0" Margin="14,6,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="1.1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="状态" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="应用" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock Grid.Column="2" Text="启动影响" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock Grid.Column="3" Text="来源" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock Grid.Column="4" Text="建议" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ItemList"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="240" Height="6"/>
                <TextBlock Text="正在读取启动项…" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,14,0,0"/>
            </StackPanel>
            <TextBlock x:Name="EmptyText" Text="没有匹配的启动项" FontSize="12.5"
                       Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"
                       Visibility="Collapsed" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>
