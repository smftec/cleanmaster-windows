<Page x:Class="CleanMaster.App.Pages.StartupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FontFamily="Microsoft YaHei UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,2,4,0">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource nav.startup}" FontSize="21" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Border x:Name="BootTimeChip" Background="{DynamicResource PrimarySoftBrush}" CornerRadius="8"
                            Padding="9,3,9,4" VerticalAlignment="Center" Margin="14,2,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="BootTimeText" FontSize="11.5" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{DynamicResource startup.desc}" FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,8,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Grid Width="220" VerticalAlignment="Center">
                    <TextBlock x:Name="SearchHint" Text="{DynamicResource startup.search.hint}" FontSize="13"
                               Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"
                               Margin="10,0,0,0" IsHitTestVisible="False"/>
                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"/>
                </Grid>
                <Button x:Name="BtnRefresh" Content="{DynamicResource btn.refresh}" Style="{StaticResource SecondaryButton}"
                        Padding="18,8" Margin="12,0,0,0" Click="BtnRefresh_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="2,14,2,0">
            <Border Style="{StaticResource CardBorder}" Padding="10,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- 表头 -->
                    <Grid Grid.Row="0" Margin="14,6,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="1.1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource startup.col.toggle}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource apps.col.name}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock Grid.Column="2" Text="{DynamicResource startup.col.impact}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock Grid.Column="3" Text="{DynamicResource startup.col.source}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock Grid.Column="4" Text="{DynamicResource startup.col.suggest}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ItemList"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" Margin="14,8,14,8">
                <TextBlock Text="{DynamicResource startup.loading}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="2,2,0,12"/>
                <Border Style="{StaticResource SkeletonRow}" Width="320" HorizontalAlignment="Left"/>
                <Border Style="{StaticResource SkeletonRow}" Width="560" HorizontalAlignment="Left"/>
                <Border Style="{StaticResource SkeletonRow}" Width="470" HorizontalAlignment="Left"/>
                <Border Style="{StaticResource SkeletonRow}" Width="610" HorizontalAlignment="Left"/>
                <Border Style="{StaticResource SkeletonRow}" Width="520" HorizontalAlignment="Left"/>
                <Border Style="{StaticResource SkeletonRow}" Width="430" HorizontalAlignment="Left"/>
            </StackPanel>
            <TextBlock x:Name="EmptyText" Text="{DynamicResource startup.empty}" FontSize="12.5"
                       Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"
                       Visibility="Collapsed" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>
