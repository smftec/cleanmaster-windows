<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 深色主题画刷 ===== -->
    <Color x:Key="PrimaryColor">#4C8DF6</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#4C8DF6"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#639DF8"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#3B77DC"/>
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#5C9AF8" Offset="0"/>
        <GradientStop Color="#3672E4" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#25324D"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2CB7A5"/>

    <SolidColorBrush x:Key="WindowBgBrush" Color="#171C28"/>
    <LinearGradientBrush x:Key="PageBgBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A2130" Offset="0"/>
        <GradientStop Color="#161C29" Offset="0.5"/>
        <GradientStop Color="#181E2C" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#1B2231"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#212A3C"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2C3852"/>
    <SolidColorBrush x:Key="NavActiveBgBrush" Color="#25324D"/>
    <SolidColorBrush x:Key="NavHoverBgBrush" Color="#1F2940"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8EDF8"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9FACCB"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6B799C"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#43C468"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1C3527"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#EFB35C"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#3A3122"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E96A6A"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3C2427"/>
    <SolidColorBrush x:Key="OrangeBrush" Color="#F58A4B"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="#A78BFA"/>
    <SolidColorBrush x:Key="TealBrush" Color="#2DD4BF"/>
    <SolidColorBrush x:Key="PinkBrush" Color="#F472B6"/>

    <SolidColorBrush x:Key="DividerBrush" Color="#2A3750"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#2C3852"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#AA000000"/>
    <SolidColorBrush x:Key="ItemHoverBrush" Color="#25324D"/>
    <SolidColorBrush x:Key="ItemPressedBrush" Color="#2A3A5C"/>
    <SolidColorBrush x:Key="ShadowBrush" Color="#66000000"/>
    <SolidColorBrush x:Key="TooltipBgBrush" Color="#2A3450"/>
    <SolidColorBrush x:Key="TooltipTextBrush" Color="#E8EDF8"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="#1B2231"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#33405F"/>
</ResourceDictionary>
