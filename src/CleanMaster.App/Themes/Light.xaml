<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 浅色主题画刷（默认） ===== -->
    <Color x:Key="PrimaryColor">#2774F0</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2774F0"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#3F86F5"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1D5FD0"/>
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3B87F8" Offset="0"/>
        <GradientStop Color="#1E64DC" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#EAF2FF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2CB7A5"/>

    <SolidColorBrush x:Key="WindowBgBrush" Color="#F2F6FD"/>
    <LinearGradientBrush x:Key="PageBgBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EAF2FF" Offset="0"/>
        <GradientStop Color="#F6F9FF" Offset="0.5"/>
        <GradientStop Color="#EFF4FD" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E3EAF6"/>
    <SolidColorBrush x:Key="NavActiveBgBrush" Color="#EAF2FF"/>
    <SolidColorBrush x:Key="NavHoverBgBrush" Color="#F2F6FD"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#17263F"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#66738C"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9AA6BC"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#31A354"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E6F6EB"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#E6A23C"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FCF3E5"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#D84A4A"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FBEAEA"/>
    <SolidColorBrush x:Key="OrangeBrush" Color="#F97316"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="TealBrush" Color="#14B8A6"/>
    <SolidColorBrush x:Key="PinkBrush" Color="#EC4899"/>

    <SolidColorBrush x:Key="DividerBrush" Color="#EDF1F8"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#E4EAF4"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#8A000000"/>
    <SolidColorBrush x:Key="ItemHoverBrush" Color="#F4F8FF"/>
    <SolidColorBrush x:Key="ItemPressedBrush" Color="#EAF2FF"/>
    <SolidColorBrush x:Key="ShadowBrush" Color="#14274A85"/>
    <SolidColorBrush x:Key="TooltipBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TooltipTextBrush" Color="#17263F"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#D8E1F0"/>
</ResourceDictionary>
