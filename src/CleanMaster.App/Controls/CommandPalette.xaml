<UserControl x:Class="CleanMaster.App.Controls.CommandPalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI"
             Visibility="Collapsed">
    <Border x:Name="Dim" Background="#66000000" MouseLeftButtonDown="Dim_MouseDown">
        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="16"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                Width="560" VerticalAlignment="Top" Margin="0,110,0,0"
                KeyboardNavigation.TabNavigation="Cycle">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel>
                <Grid Margin="18,14,18,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource ScanIcon}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center"/>
                    <Grid Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock x:Name="Placeholder" Text="{DynamicResource cmd.placeholder}" FontSize="15"
                                   Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                        <TextBox x:Name="Input" FontSize="15" BorderThickness="0" Background="Transparent"
                                 Padding="0,8" CaretBrush="{DynamicResource PrimaryBrush}"
                                 VerticalContentAlignment="Center"
                                 PreviewKeyDown="Input_PreviewKeyDown" TextChanged="Input_TextChanged"/>
                    </Grid>
                </Grid>
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="14,8,14,0"/>
                <ListBox x:Name="List" BorderThickness="0" Background="Transparent"
                         Margin="8,8,8,4" MaxHeight="352" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseDown="List_PreviewMouseDown"/>
                <TextBlock x:Name="EmptyText" Text="{DynamicResource cmd.empty}" FontSize="12.5"
                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="22,10,0,12"
                           Visibility="Collapsed"/>
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="14,0,14,0"/>
                <TextBlock Text="{DynamicResource cmd.hint}" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="18,9,18,11"/>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
